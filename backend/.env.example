# SMART AQI backend environment. Copy to backend/.env and fill in.
# backend/.env is git-ignored and must never be committed or sent to the frontend.

# --- MongoDB (local server, inspected with MongoDB Compass) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smart_aqi

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_HOURS=24
BCRYPT_ROUNDS=12

# --- App ---
FLASK_ENV=development
FLASK_DEBUG=true
FRONTEND_URL=http://localhost:5173

# --- External data services (offline pipelines only, never exposed to React) ---
# Free key from https://data.gov.in  (account -> API key)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_AQI_RESOURCE=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
OPEN_METEO_BASE=https://api.open-meteo.com

# scripts/refresh_worker.py re-pulls the CPCB live feed every this-many minutes
LIVE_REFRESH_MINUTES=45

# RNG seed for the ML training run (deterministic; change only to explore variance)
ML_SEED=42
